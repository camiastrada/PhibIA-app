# Copiar este archivo como .env (en la misma carpeta) y completar con valores reales.
# .env NO se sube a git — cada uno usa sus propias credenciales.
# Para generar una clave JWT segura:  python -c "import secrets; print(secrets.token_hex(32))"

# ========== BASE DE DATOS ==========
POSTGRES_HOST=db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_PORT=5432

# ========== JWT / SEGURIDAD ==========
# Clave secreta para firmar los tokens. OBLIGATORIO. La app no arranca sin ella.
JWT_SECRET_KEY=
# En producción usar 'True' (requiere HTTPS). En local: 'False'
JWT_COOKIE_SECURE=False

# ========== CLOUDINARY ==========
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========== BREVO (SMTP) ==========
# Brevo: dashboard > tu perfil > SMTP & API > pestaña SMTP
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# ========== OTROS ==========
# URL pública del frontend, para armar el link del mail de recuperación
FRONTEND_URL=http://localhost

# Entorno de Flask: development / production
FLASK_ENV=development