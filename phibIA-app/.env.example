# Copiar este archivo como .env (en la misma carpeta) y completar con valores reales.
# .env NO se sube a git — cada uno usa sus propias credenciales.

# Brevo: dashboard > tu perfil > SMTP & API > pestaña SMTP
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# URL pública del frontend, para armar el link del mail de recuperación
FRONTEND_URL=http://localhost

# Frontend: prefijo de la API, relativo al origen desde el que se sirve la app.
# Se aplica en TIEMPO DE BUILD (Vite la reemplaza al compilar), no en runtime:
# definarla sólo en `environment:` de docker-compose no tiene efecto.
# Se inyecta como build arg en docker-compose.yml -> frontend.build.args.
# Debe quedar relativa: un origen absoluto (ej. http://localhost:5000) sólo
# funciona si el navegador corre en la misma máquina que el backend, y rompe al
# acceder desde un celular u otra PC por un túnel de puertos.
# Definida en un solo lugar del código: frontend/src/config/api.ts
VITE_API_URL=/api
